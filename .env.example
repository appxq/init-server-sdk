# ===== Service =====
SERVICE_NAME = 'API Builder'
SERVICE_VERSION = '1.5.0'
ASSETS_PATH = 'assets/'

# ===== Network =====
# ใน container ต้อง bind 0.0.0.0 ไม่ใช่ localhost (ไม่งั้น Coolify เข้าไม่ถึง)
HOST = '0.0.0.0'
PORT = 8080
FRONTEND_URL = "https://your-frontend.example.com"
DOMAIN_URL = "https://your-api.example.com"

# ===== MongoDB =====
MONGODB_URL = "mongodb://host:27017"
MONGODB_NAME = "initcraft"
MONGODB_USERNAME = "initcraft"
MONGODB_PASSWORD = "__CHANGE_ME__"

# ===== Auth =====
JWT_SECRET = "__CHANGE_ME__"
APP_NAME = "Initcraft"
# CORS allow-list (คั่นด้วย comma)
APP_URL = "https://your-frontend.example.com"
APP_MAXSIZE = 100

# ===== Mailer =====
MAILER_HOST = "smtp.gmail.com"
MAILER_PORT = 465
MAILER_SECURE = "true"
MAILER_USER = "you@example.com"
MAILER_PASSWORD = "__CHANGE_ME__"
MAILER_FROM = "Admin <you@example.com>"

# ===== Websocket / Login =====
WS_MAX = 1048576
LOGIN_LIMIT = 0
LOGIN_EXPIRES = 86400000

# ===== Keys (multiline ใส่ผ่าน Coolify env ได้) =====
PRIVATE_KEY = ""
PUBLIC_KEY = ""

# ===== OAuth2 / Register =====
REGISTER_ID = ""
OAUTH2_ID = ""
OAUTH2_SECRET = ""
